# Bot X9 — copie para bot/.env (docs/BOT_X9.md §6).

# Developer Portal → Applications → seu app → Bot → Reset Token.
# Ligue o "Message Content Intent" na mesma página.
DISCORD_TOKEN=
# Servidor(es) do grupo, separados por vírgula (botão direito → Copiar ID;
# precisa do Modo Desenvolvedor). Os /comandos são globais e valem em todo
# servidor em que o X9 estiver; aqui ele só limpa cópias antigas duplicadas.
DISCORD_GUILD_ID=
# Canal onde sai o placar (o mesmo do webhook do poller).
ANNOUNCE_CHANNEL_ID=

# Mesmo banco do site: URI do session pooler do Supabase.
DATABASE_URL=
# Para baixar sob demanda o detalhe de partidas que só têm resumo.
HENRIKDEV_API_KEY=

# LLM: Gemini (aistudio.google.com → Get API key) e Groq de reserva (console.groq.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reserva com cota por minuto separada (vazio desliga)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Rotas: ordem dos provedores por tarefa (gemini | groq | groq-small).
# LLM_ORDER_TEXT=gemini,groq,groq-small
# LLM_ORDER_VOICE=groq,groq-small,gemini
# LLM_ORDER_GOSSIP=gemini,groq,groq-small
# GEMINI_GOSSIP_THINKING=512

# Voz
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# Com GPU NVIDIA dá para trocar por: WHISPER_MODEL=large-v3-turbo e WHISPER_COMPUTE=int8_float16
# WHISPER_COMPUTE=
# VOICE_SILENCE_S=0.55
# VOICE_EARLY_WAKE=auto
TTS_ENGINE=auto
TTS_VOICE=pt-BR-AntonioNeural
PIPER_VOICE=pt_BR-faber-medium

# Ajustes finos (opcionais)
# GOSSIP_POLL_S=120
# GOSSIP_MAX_AGE_H=48
# BOT_CLAIM_AFTER_MIN=80
# BOT_POSTS_SCOREBOARD=1
# Ao vivo (presença do Discord + checagem rápida na HenrikDev)
# LIVE_ENABLED=1
# LIVE_BASE_EVERY_S=300
# LIVE_PLAYING_EVERY_S=60
# LIVE_MIN_GAP_S=5
# LIVE_FETCH_SIZE=2
# Resposta escrita ao vivo, extras da fofoca e momentos proativos (1 liga, 0 desliga)
# STREAM_REPLIES=1
# GOSSIP_REACTIONS=1
# MVP_VOTE=1
# PROACTIVE_RANK=1
# PROACTIVE_PREFILA=1
# PROACTIVE_NIGHT=1
# PROACTIVE_OSCAR=1
