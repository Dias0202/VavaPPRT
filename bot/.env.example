# Bot X9 — copie para bot/.env (docs/BOT_X9.md §6).

# Developer Portal → Applications → seu app → Bot → Reset Token.
# Ligue o "Message Content Intent" na mesma página.
DISCORD_TOKEN=
# Servidor(es) do grupo, separados por vírgula (botão direito → Copiar ID;
# precisa do Modo Desenvolvedor). Os /comandos são globais e valem em todo
# servidor em que o X9 estiver; aqui ele só limpa cópias antigas duplicadas.
DISCORD_GUILD_ID=
# Canal onde sai o placar (o mesmo do webhook do poller).
ANNOUNCE_CHANNEL_ID=

# Mesmo banco do site: URI do session pooler do Supabase.
DATABASE_URL=
# Para baixar sob demanda o detalhe de partidas que só têm resumo.
HENRIKDEV_API_KEY=

# LLM: Gemini (aistudio.google.com → Get API key) e Groq de reserva (console.groq.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Voz
WHISPER_MODEL=small
WHISPER_DEVICE=auto
TTS_ENGINE=auto
TTS_VOICE=pt-BR-AntonioNeural
PIPER_VOICE=pt_BR-faber-medium

# Ajustes finos (opcionais)
# GOSSIP_POLL_S=120
# GOSSIP_MAX_AGE_H=48
# BOT_CLAIM_AFTER_MIN=80
# BOT_POSTS_SCOREBOARD=1
