# Banco. Produção: URI do *session pooler* do Supabase (IPv4), ex.:
# postgresql://USUARIO.PROJETO:SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Sem isto, a API usa SQLite local em backend/data/app.db (dev).
DATABASE_URL=

# Chave Basic da API HenrikDev (https://docs.henrikdev.xyz/) — 30 req/min.
HENRIKDEV_API_KEY=

# Riot ID (Nome#TAG) de quem administra o grupo: nasce admin e aprovado.
# Todo outro cadastro espera aprovação.
ADMIN_RIOT_ID=

# Segredo para assinar os JWT. Em produção é obrigatório (a API não sobe sem).
JWT_SECRET=troque-este-segredo

# Origens liberadas para o frontend (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Região usada só quando a conta não informa a própria (a HenrikDev devolve
# "na" para contas do Brasil).
DEFAULT_REGION=na

# Orçamento do poller por execução (Basic Key = 30 req/min).
DEEP_PER_RUN=10
MMR_REFRESH_HOURS=6

# Bot X9 (docs/BOT_X9.md) — tudo opcional.
# Token de serviço do espelho HTTP /bot/v1 (vazio = rota responde 503).
BOT_API_TOKEN=
# Webhook do canal do placar: o poller anuncia cada partida nova.
DISCORD_WEBHOOK_URL=
# Link da página da partida no embed.
SITE_URL=
ANNOUNCE_LOOKBACK_HOURS=6
