# Banco (Supabase). Sem isto, usa SQLite local em backend/data/app.db (dev).
DATABASE_URL=postgresql://postgres:senha@db.supabase.co:5432/postgres

# Chave Basic da API HenrikDev (https://docs.henrikdev.xyz/) — 30 req/min.
HENRIKDEV_API_KEY=

# Segredo para assinar os JWT (gere um valor aleatório longo em produção).
JWT_SECRET=troque-este-segredo

# Origens liberadas para o frontend (CORS), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Região padrão da Riot: na, eu, ap, kr, latam, br.
DEFAULT_REGION=latam

# Minutos de validade do cache de telemetria.
CACHE_TTL_MINUTES=10
